# ===========================================================
#  Variables de entorno — SIGTH (Reflejos Brillantes)
# ===========================================================
# Copia este archivo a `.env` (desarrollo) o configúralo en el panel
# de Netlify (Site settings → Environment variables) para producción.
# ------------------------------------------------------------

# --- IA Z.ai (opcional pero recomendado) ---
# Necesarias para que funcionen el análisis de HV con IA, generación de HV
# y fetch-URL. Si no las defines, el resto del aplicativo (33 formatos,
# archivador, respaldos, etc.) sigue funcionando.
ZAI_API_KEY=tu_api_key_de_z_ai_aqui
ZAI_BASE_URL=https://api.z.ai/api/v2

# Opcionales (sesión de chat / usuario — solo relevantes en el sandbox)
# ZAI_CHAT_ID=
# ZAI_USER_ID=
# ZAI_TOKEN=

# --- Base de datos (opcional, solo si activas Prisma) ---
# DATABASE_URL=file:./prisma/dev.db
